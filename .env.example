# development | production (production grava logs em JSON)
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
DATABASE_URL=postgres://planejo:planejo@localhost:5435/planejo?sslmode=disable
# origens do frontend, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
# URL do projeto no Supabase (a API valida os tokens pelo JWKS dele)
SUPABASE_URL=https://seu-projeto.supabase.co
